  {
   "kind": 2,
   "value": "Na = Integrate[c1[a], {a, a1, a2}, Assumptions -> {b>0, λ>0, ρe>0, ρc>0, δc>0, a1>0, a2>a1}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wrow><w></w><w>-</w><wfrac><w><wrow><w></w><wsup><w></w><w>𝕖</w><w><wrow><w></w><wrow><w></w><w>-</w><w>d</w></wrow><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>b</w><w></w><wrow><w></w><wb>(</wb><wrow><w></w><w>L1</w><w>-</w><w>L2</w></wrow><wb>)</wb></wrow></wrow><w>+</w><wrow><w></w><wrow><w></w><wb>(</wb><wrow><w></w><w>a1</w><w>+</w><w>a2</w></wrow><wb>)</wb></wrow><w></w><w>L2</w></wrow></wrow><wb>)</wb></wrow></wrow></w></wsup><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wsup><w></w><w>𝕖</w><w><wrow><w></w><w>a1</w><w></w><w>d</w><w></w><w>L2</w></wrow></w></wsup><w>-</w><wsup><w></w><w>𝕖</w><w><wrow><w></w><w>a2</w><w></w><w>d</w><w></w><w>L2</w></wrow></w></wsup></wrow><wb>)</wb></wrow><w></w><w>r</w></wrow></w><w><w></w><w><w>d</w></w></w></wfrac></wrow></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "-(((E^(a1*d*L2) - E^(a2*d*L2))*r)/(d*E^(d*(b*(L1 - L2) + (a1 + a2)*L2))))",
