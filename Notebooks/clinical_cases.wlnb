  {
   "kind": 1,
   "value": "## Exponential decay clinical model",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "c_exp[a_] := ρc*l[a]*Exp[-δc*n[a]]\nc_exp[a]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wrow><w></w><wsup><w></w><w>𝕖</w><w><wrow><w></w><wrow><w></w><w>-</w><w>d</w></wrow><w></w><w>L</w><w></w><wrow><w></w><wb>(</wb><wrow><w></w><w>a</w><w>+</w><wfrac><w><wrow><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>-</w><w>1</w></wrow><w>+</w><wsup><w></w><w>𝕖</w><w><wrow><w></w><wrow><w></w><w>-</w><w>a</w></wrow><w></w><w>b</w></wrow></w></wsup></wrow><wb>)</wb></wrow><w></w><w>u</w></wrow></w><w><w></w><w><w>b</w></w></w></wfrac></wrow><wb>)</wb></wrow></wrow></w></wsup><w></w><w>L</w><w></w><w>r</w><w></w><wrow><w></w><wb>(</wb><wrow><w></w><w>1</w><w>-</w><wrow><w></w><wsup><w></w><w>𝕖</w><w><wrow><w></w><wrow><w></w><w>-</w><w>a</w></wrow><w></w><w>b</w></wrow></w></wsup><w></w><w>u</w></wrow></wrow><wb>)</wb></wrow></wrow></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "(L*r*(1 - u/E^(a*b)))/E^(d*L*(a + ((-1 + E^(-(a*b)))*u)/b))",
       "mime": "text/plain"
      }
     ],
     "id": "6ae2d814-9c54-4154-b888-fb175f84702f",
