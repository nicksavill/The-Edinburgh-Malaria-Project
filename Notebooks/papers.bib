
@article{Baird2013,
	title = {Suppressive chemoprophylaxis invites avoidable risk of serious illness caused by plasmodium vivax malaria},
	volume = {11},
	issn = {14778939},
	doi = {10.1016/j.tmaid.2013.01.002},
	abstract = {Despite inadequacy in preventing vivax malaria after travel, suppressive chemoprophylaxis has dominated travel medicine strategy since the advent of chloroquine in 1946. The lethal threat of falciparum malaria versus the perceived benign consequence of vivax malaria underpins this strategic posture. Recent evidence demonstrating vivax malaria as often pernicious should prompt reconsideration of that posture. Causal prophylaxis kills early developing forms of plasmodia in the liver, thus preventing attacks of falciparum and vivax malaria during travel and delayed onset vivax malaria following travel. Primaquine is the only available drug for this application, and has good evidence of safety, tolerability and efficacy in non-pregnant, G6PD-normal travelers. The primaquine label, however, carries no such indication. Risk of pernicious vivax malaria from all across the endemic regions of the globe, including much of sub-Saharan Africa, should raise consideration of daily primaquine during travel as the preferred front-line option for chemoprophylaxis against malaria in travelers.},
	language = {en},
	number = {1},
	journal = {Travel Medicine and Infectious Disease},
	author = {Baird, J. Kevin},
	month = jan,
	year = {2013},
	pmid = {23454204},
	keywords = {Malaria, Plasmodium vivax, Causal prophylaxis, Primaquine},
	pages = {60--65},
	file = {PDF:/home/njs/Zotero/storage/L2CLMTB4/1-s2.0-S1477893913000045-main.pdf:application/pdf},
}

@article{Fryauff1997,
	title = {Malaria in a nonimmune population after extended chloroquine or primaquine prophylaxis},
	volume = {56},
	doi = {10.4269/ajtmh.1997.56.137},
	abstract = {Extended chemoprophylaxis against endemic malaria raises concern with regard to susceptibility after ceasing use of the drug. In this study, we measured attack rates of malaria among adult men for 28 weeks after they ended one year of prophylaxis using either weekly chloroquine (5 mg base/kg, n = 20), daily primaquine (0.5 mg base/kg, n = 30), or a placebo of primaquine (n = 41). The 28-week incidence densities, times to parasitemia, parasite densities, and symptoms of primary post-prophylaxis infections were not significantly different among the former primaquine, chloroquine, and placebo groups. However, the incidence of Plasmodium falciparum infection in the post-chloroquine group was significantly greater than in the post-primaquine group during the first (P = 0.03) and second (P = 0.02) months post-prophylaxis. Six of 10 primary P. falciparum and three of 10 P. vivax infections occurred in the former chloroquine group within one month after ending prophylaxis and the mean time to infection was 30â€"35days. In contrast, only one P. falciparum and no P. vivax infections occurred during the first month after ending primaquine prophylaxis. The mean time to first parasitemia by either species of malaria parasite in this group was 72â€"77days. There was no indication that daily use of primaquine for one year placed subjects at greater risk of malaria infection or to more severe clinical symptoms of malaria than subjects who had taken placebo or chloroquine, despite the potential for some degree of immunity to have been acquired in these latter two groups during the year long prophylaxis period. The results do suggest that chloroquine suppressed P. falciparum infections until drug levels decreased, and that primaquine had effectively prevented the establishment of liver-stage parasites. Chemoprophylaxis against malaria for extended periods causes apprehension in both patient and physician. Although any overt toxicity of drug raises obvious concerns, more subtle considerations may govern decisions about strategies for long-term chemoprophylaxis. For example, immunosup pressive properties of drugs such as chloroquine or prima 2 may cause anxiety among traveling patients facing many months of exposure to risk of malaria. On the other hand, the practitioner in an endemic area may worry about interrupting natural exposure and thus compromising ac quired immunity.3 In any event, fear of severe malaria fol lowing prophylaxis looms over recommendations for people exposed to risk of infection for extended periods. This laboratory conducted a year-long, double-blinded chemoprophylaxis trial in northeastern Irian Jaya, Indonesia that documented the marked efficacy of primaquine versus either chloroquine or placebo for malaria prevention.4 In the results reported here, we continued following subjects for seven months after cessation of prophylaxis. The primary objective of follow-up was to primarily provide after-care to the study volunteers, and secondarily, to gauge relative sus ceptibility and response to post-prophylaxis parasitemias in the chloroquine, primaquine, and placebo groups. MATERIALS AND METHODS Subjects and study site. Detailed descriptions of the study subjects and site have been presented elsewhere.4 Jay anese men, resident in Irian Jaya as transmigrant farmers for six months, had been randomized to receive either chloro quine (5 mg base/kg/week), primaquine (0.5 mg base/kg/ day), or a placebo (daily). None of the subjects receiving primaquine had malaria during the year of prophylaxis, but the 52-week cumulative incidence of malaria had been 55\% and 66\% in the respective chloroquine and placebo groups.4 Point prevalence of malaria in subjects prior to prophylaxis was 29\% and an estimated 0.8â€"1.0 cases of malaria/person year had occurred in the respective chloroquine and placebo groups by the end of the 12-month prophylaxis period. In fections had been treated with quinine and consenting vol unteers had continued under the same routine of supervised prophylaxis. Enrollment in the post-prophylaxis surveillance was done after informed consent was obtained and restricted to study subjects who had taken the originally assigned drug or placebo for the full one-year trial period. Indonesian and American committees for the protection of human subjects in medical research reviewed and approved these proce dures. This work was conducted in accordance with U.S. Navy and Republic of Indonesia regulations governing the protection of human subjects in medical research.},
	language = {en},
	number = {2},
	journal = {American. Journal of Tropical Medicine and  Hygiene},
	author = {Fryauff, David J and Baird, J Kevin and Awalludin, Mochammad and Jones, Trevor and Subianto, Budi and Richie, Thomas L and Tjitra, Emiliana and Wignall, F Stephen and Hoffman, Stephen L},
	year = {1997},
	note = {ISBN: 4.3)301,5674.1},
	pages = {137--140},
	file = {PDF:/home/njs/Zotero/storage/B3GXHVST/0002-9637-article-p137.pdf:application/pdf},
}

@article{baird_primaquine_1995,
	title = {Primaquine for prophylaxis against malaria among nonimmune transmigrants in irian jaya, indonesia},
	volume = {52},
	doi = {10.4269/ajtmh.1995.52.479},
	abstract = {A comparison of primaquine versus chloroquine for prophylaxis among nonimmune transmigrants from Java and Bali in the hyperendemic Arso region of Irian Jaya, Indonesia was conducted. Forty-five subjects received 0.5 mg of primaquine base/kg of body weight every other day, and 54 people in the same village received weekly 5 mg of chloroquine base/kg for 16â€"19 weeks beginning in December 1992. Plasmodium falciparum accounted for I 8 of 30 infections with chioroquine, and four of five infections among subjects receiving primaquine. Plasmodium vivax was found in I2 people taking chloroquine but in just one person taking primaquine. The risk of malaria among people taking chloroquine relative to that among subjects taking primaquine was 3.96 (P = 0.014) for P. falciparum and 10.56 (P = 0.012) for P. vivax. Pnmaquine was better tolerated than chloroquine. The minimal protective efficacy for primaquine prophylaxis was 74\% against P. falciparum and 90\% against P. vivax among nonimmune children and adults living in man Jaya. These findings require confirmation with randomized, double-blinded, and placebo controlled trials. Varied patterns of resistance to therapeutic agents by P/as modium falciparum and P. vivax, together with intolerance of some drugs by many people restricts options for chemo prophylaxis against malaria. Moreover, many drugs may be prohibitively expensive or unavailable for the majority of people living in malarious areas. Safe, effective, and afford able options for protection against malaria are needed. Primaquine has been a drug-of-choice for radical cure and terminal prophylaxis (presumptive therapy administered to travelers returning from endemic areas) against malaria for more than 40 years. The causal prophylactic activity of pri maquine has been 2 but this property was never evaluated under conditions of natural exposure. This may be partially due to the prevailing view that primaquine is too toxic for routine chemoprophylaxis.3@ Real or perceived problems with toxicity notwithstanding, the vanishing effi cacy of chloroquine and other blood schizonticidal drugs for prophylaxis against malaria prompted this study of prima quine as an agent of prophylaxis. This report describes an evaluation of the safety and efficacy of primaquine relative to chioroquine for prophylaxis in nonimmune people arriv ing in a hyperendemic area of Irian Jaya, Indonesia. SUBJECTS AND METHODS Study site. The village of Arso X in the Arso region of northeastern man Jaya served as the study site. Arso X opened to transmigrants from Java and Bali in early Novem ber I 992. Dense jungle surrounded the 2-km2 area contain ing the 400 houses and public buildings of the village. The grounds where the village stood had only recently been cleared of jungle. The demographic, socioeconomic, malar iometric, entomologic, and physical features of the Arso re gion have been described in other reports.7'Â° Malariometric survey. The prevalence of malaria was recorded at the beginning of this study. Blood films from more than 90\% of residents (275 of approximately 300) were examined. Also, records of passive malaria case detection 479 were maintained by the field clinic established by the re search team. This clinic was the only health care delivery facility within 15 km. Care was provided at no charge to all residents, regardless of participation in the prophylaxis study. All parasitologic diagnoses were made by experienced microscopists using standard Giemsa staining and light mi croscopic techniques. Entomologic surveillance and assays for sporozoites were conducted as described elsewhere.' Study population. Study subjects were enrolled on the day of their arrival in Irian Jaya. They traveled by aircraft from Java or Bali and the research team met them at a near by temporary housing facility. To minimize the likelihood of infection during the first night, mosquito repellent cream (40\% DEET) was given to all. Also, the area around the sleeping quarters was sprayed using hand-held ultra-low vol ume equipment and malathion (96\% active ingredient ap were treated as described above. Volunteers were interviewed and examined by a physician. People admitting a history of exposure to malaria were excluded from participation, as were females and children less than three years of age. Females were ex cluded because primaquine is not known to be safe to fetuses and surveillance for pregnancy among study subjects was not practical. Some subjects were randomized into the two study groups, but others were not. When randomization was possible, it was accomplished by drawing a study number blindly from a bag containing all study numbers for both groups. The first group of adult males (n = 22) were delib erately placed in the chloroquine group to accommodate an other research protocol. Therefore, the last group of trans migrants (n = 24) were deliberately placed into the prima I@ IIII@I@Ill @ @II@I @ IIII},
	language = {en},
	number = {6},
	journal = {American Journal of Tropical Medicine and Hygiene},
	author = {Baird, J Kevin and Fryauff, David J and Basri, Hasan and Bangs, Michael J and Subianto, Budi and Wiady, Iwa and Leksana, Budhi and Masbar, Sofyan and Richie, Thomas L and Jones, Trevor R and Tjitra, Emiliana and Wignall, Stephen and Hoffman, Stephen L},
	year = {1995},
	pages = {479--484},
	file = {PDF:/home/njs/Zotero/storage/FIE47E83/0002-9637-article-p479.pdf:application/pdf},
}

@article{Lacy2002,
	title = {Atovaquone/proguanil therapy for plasmodium falciparum and plasmodium vivax malaria in indonesians who lack clinical immunity},
	volume = {35},
	doi = {10.1086/343750},
	abstract = {Thirty-eight of 295 subjects participating in a randomized, double-blind, placebo-controlled trial of the efficacy of daily administration of atovaquone/proguanil for malaria prevention developed malaria at some time during the 20-week pro-phylaxis period. These subjects (3 atovaquone/proguanil recipients and 35 placebo recipients) were treated with 4 tablets of atovaquone/proguanil per day for 3 days. Atovaquone/pro-guanil provided safe, well-tolerated, and effective therapy for uncomplicated malaria in nonimmune Indonesians. Malaria is the most common life-threatening infectious disease among travelers. Chemoprophylaxis effectively reduces the risk of acquiring disease, but many people who could benefit from chemoprophylaxis do not use it as directed [1]. Each year, 110,000 North American and European people acquire malaria while traveling abroad, and several hundred of these people die [2, 3]. Deterioration of the global malaria},
	language = {en},
	journal = {Clinical infectious diseases},
	author = {Lacy, Mark D and Maguire, Jason D and Barcus, Mazie J and Ling, Judith and Bangs, Michael J and Gramzinski, Robert and Basri, Hasan and Sismadi, Priyanto and Miller, Gerri B and Chulay, Jeffrey D and Fryauff, David J and Hoffman, Stephen L and Baird, J Kevin},
	year = {2002},
	pages = {92--97},
	file = {PDF:/home/njs/Zotero/storage/5EQVKKB3/35-9-e92.pdf:application/pdf},
}

@article{Baird2003,
	title = {Adult javanese migrants to indonesian papua at high risk of severe disease caused by malaria},
	volume = {131},
	issn = {09502688},
	doi = {10.1017/S0950268803008422},
	abstract = {Migrants from Java arrive in hyperendemic Papua, Indonesia lacking exposure to endemic malaria. We evaluated records of evacuation to hospital with a diagnosis of severe malaria from a transmigration village in northeastern Papua. During the first 30 months, 198 residents with severe disease were evacuated (7.5 evacuations/100 person-years). During this period the risk of evacuation for adults ({\textgreater} 15 years of age) was 2.8. (95\% CI = 2.1-3.8; P {\textless} 0.0001) relative to children, despite apparently equal exposure to risk of infection. Relative risk (RR) for adults was greatest during the first 6 months (RR {\textgreater} 16; 95\% CI ≥ 2.0-129; P = 0.0009), and diminished during the second 6 months (RR = 9.4; 95\% CI = 2.7-32.8; P {\textless} 0.0001) and the third 6 months (RR = 3.7; 95\% CI = 1.7-7.9; P = 0.0004). During the next two 6-month intervals, the RR for adults was 1.6 and 1.5 (95\% CI range 0.8-2.6; P {\textless} 0.18). Adults lacking chronic exposure were far more likely to progress to severe disease compared to children during initial exposure, but not after chronic exposure to infection.},
	language = {en},
	number = {1},
	journal = {Epidemiology and Infection},
	author = {Baird, J. K. and Basri, H. and Weina, P. and Maguire, J. D. and Barcus, M. J. and Picarema, H. and Elyazar, I. R. F. and Ayomi, E. and {Sekartuti}},
	month = aug,
	year = {2003},
	pmid = {12948380},
	keywords = {★},
	pages = {791--797},
	file = {PDF:/home/njs/Zotero/storage/F8NC4N8D/adult-javanese-migrants-to-indonesian-papua-at-high-risk-of-severe-disease-caused-by-malaria.pdf:application/pdf},
}

